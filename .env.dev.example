# Documentation only; configure in the isolated dev Vercel project's
# Production (stable review site) and Preview environments.
# Vercel system VERCEL_URL supplies the preview's runtime redirect origin.
SGN_ENV=dev
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_DEV_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=https://YOUR_DEV_APP_DOMAIN
# Release-only guard, never a browser variable:
EXPECTED_SUPABASE_PROJECT_REF=YOUR_DEV_PROJECT_REF
# Server-only; the same key is in use for both stages today. Independent per-stage keys are the
# intended end state; a separate key needs its own private DB row and a production redeploy.
SGN_FILE_VALIDATION_KEY=YOUR_DEV_64_LOWERCASE_HEX_KEY
# Server-only trusted-server capability for the employee administration provider steps and
# the released-upload cleanup pass. Never a NEXT_PUBLIC_ variable and never exposed to browser
# code; missing configuration fails those steps closed and leaves the work pending.
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_SECRET_KEY
# Server-only Cloudflare R2 storage for the dev bucket (private; presigned upload/download
# only). Missing values fail file operations closed instead of falling back to Supabase
# Storage. Never a NEXT_PUBLIC_ variable and never committed with real values.
R2_ACCOUNT_ID=YOUR_DEV_R2_ACCOUNT_ID
R2_BUCKET=YOUR_DEV_R2_BUCKET_NAME
# Stage binding for the legacy workbook import only: the dev bucket and account the import
# refuses to write outside of. Never browser variables.
EXPECTED_R2_BUCKET=YOUR_DEV_R2_BUCKET_NAME
EXPECTED_R2_ACCOUNT_ID=YOUR_DEV_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_DEV_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_DEV_R2_SECRET_ACCESS_KEY

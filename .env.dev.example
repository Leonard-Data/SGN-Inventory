# Documentation only; configure in the isolated dev Vercel project's
# Production (stable review site) and Preview environments.
# Vercel system VERCEL_URL supplies the preview's runtime redirect origin.
SGN_ENV=dev
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_DEV_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=https://YOUR_DEV_APP_DOMAIN
# Release-only guard, never a browser variable:
EXPECTED_SUPABASE_PROJECT_REF=YOUR_DEV_PROJECT_REF
# Server-only, unique to this stage; matching private DB singleton required.
SGN_FILE_VALIDATION_KEY=YOUR_DEV_64_LOWERCASE_HEX_KEY
# Server-only Auth admin capability for the provider sign-in block during employee
# deactivation. Never a NEXT_PUBLIC_ variable and never exposed to browser code; missing
# configuration fails the provider step closed and leaves the operation pending.
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_SECRET_KEY

# Documentation only; configure in the isolated prod Vercel project.
# Never copy production configuration to local development or previews.
SGN_ENV=prod
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROD_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PROD_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=https://YOUR_PROD_APP_DOMAIN
# Release-only guard, never a browser variable:
EXPECTED_SUPABASE_PROJECT_REF=YOUR_PROD_PROJECT_REF
# Server-only, unique to this stage; separate provisioning authorization required.
SGN_FILE_VALIDATION_KEY=YOUR_PROD_64_LOWERCASE_HEX_KEY
# Server-only Auth admin capability for the provider sign-in block during employee
# deactivation. Never a NEXT_PUBLIC_ variable and never exposed to browser code; missing
# configuration fails the provider step closed and leaves the operation pending.
SUPABASE_SERVICE_ROLE_KEY=YOUR_PROD_SERVICE_ROLE_SECRET_KEY
# Server-only Cloudflare R2 storage for the prod bucket (private; presigned upload/download
# only). Provisioned separately from the dev bucket; never copy these values to local
# development or previews. Missing values fail file operations closed.
R2_ACCOUNT_ID=YOUR_PROD_R2_ACCOUNT_ID
R2_BUCKET=YOUR_PROD_R2_BUCKET_NAME
R2_ACCESS_KEY_ID=YOUR_PROD_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_PROD_R2_SECRET_ACCESS_KEY

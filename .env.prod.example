# Documentation only; configure in the isolated prod Vercel project.
# Never copy production configuration to local development or previews.
SGN_ENV=prod
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROD_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PROD_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=https://YOUR_PROD_APP_DOMAIN
# Release-only guard, never a browser variable:
EXPECTED_SUPABASE_PROJECT_REF=YOUR_PROD_PROJECT_REF
# Server-only; currently the same key as development. Independent per-stage keys are the intended
# end state; a new key needs a matching private DB row and a production redeploy.
SGN_FILE_VALIDATION_KEY=YOUR_PROD_64_LOWERCASE_HEX_KEY
# Server-only trusted-server capability for the employee administration provider steps and
# the released-upload cleanup pass. Never a NEXT_PUBLIC_ variable and never exposed to browser
# code; missing configuration fails those steps closed and leaves the work pending.
SUPABASE_SERVICE_ROLE_KEY=YOUR_PROD_SERVICE_ROLE_SECRET_KEY
# Server-only Cloudflare R2 storage for the prod bucket (private; presigned upload/download
# only). The production import currently writes the same private bucket in the same account as
# development, so the stage binding below names that shared storage; giving production its own
# bucket is a later, separate decision. Missing values fail file operations closed.
R2_ACCOUNT_ID=YOUR_PROD_R2_ACCOUNT_ID
R2_BUCKET=YOUR_PROD_R2_BUCKET_NAME
# Stage binding for the legacy workbook import only. Production's bucket and Cloudflare account are
# pinned in scripts/legacy-import-write.mjs (PRODUCTION_R2_BUCKET, PRODUCTION_R2_ACCOUNT_ID) and
# these declarations must name them, so an environment file cannot relabel another account's
# storage as production. Never browser variables.
EXPECTED_R2_BUCKET=sgn
EXPECTED_R2_ACCOUNT_ID=88a4769b865b803f85c3f687187b7246
R2_ACCESS_KEY_ID=YOUR_PROD_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_PROD_R2_SECRET_ACCESS_KEY

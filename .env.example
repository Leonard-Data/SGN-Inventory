# Copy to .env.local; local belongs to the dev stage. Never commit actual values.
SGN_ENV=dev
# From `npx supabase status` after authorized local setup:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_LOCAL_ANON_OR_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
# No secret/service-role key is needed for the foundation or ordinary requests.

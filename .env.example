# Copy to .env.local; local belongs to the dev stage. Never commit actual values.
SGN_ENV=dev
# From `npx supabase status` after authorized local setup:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_LOCAL_ANON_OR_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
# No Supabase secret/service-role key is used for ordinary requests.
# Server-only file-completion attestation; matching private DB singleton required.
SGN_FILE_VALIDATION_KEY=YOUR_64_LOWERCASE_HEX_KEY
# Server-only trusted-server capability used only for the employee administration provider
# steps and the released-upload cleanup pass. Never prefix with NEXT_PUBLIC_ and never expose
# it to browser code. Missing or placeholder configuration fails those steps closed: membership
# is disabled and the operation stays a recorded pending/reconciliation state, and released
# uploads stay a logged, retried backlog.
SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_OR_DEV_SERVICE_ROLE_SECRET_KEY
# Server-only Cloudflare R2 storage for property file bytes (private bucket). Uploads and
# downloads use short-lived presigned URLs, so the server never streams file bytes. Missing
# values fail file operations closed instead of falling back to Supabase Storage. Never prefix
# any of these with NEXT_PUBLIC_ and never commit real values.
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_BUCKET=YOUR_R2_BUCKET_NAME
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY

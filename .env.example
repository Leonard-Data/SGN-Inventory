# Copy to .env.local; local belongs to the dev stage. Never commit actual values.
SGN_ENV=dev
# From `npx supabase status` after authorized local setup:
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_LOCAL_ANON_OR_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
# No Supabase secret/service-role key is used for ordinary requests.
# Server-only file-completion attestation; matching private DB singleton required.
SGN_FILE_VALIDATION_KEY=YOUR_64_LOWERCASE_HEX_KEY
# Server-only Auth admin capability used only for the provider sign-in block during employee
# deactivation. Never prefix with NEXT_PUBLIC_ and never expose it to browser code. Missing or
# placeholder configuration fails the provider step closed: membership is disabled and the
# operation stays a recorded pending/reconciliation state.
SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_OR_DEV_SERVICE_ROLE_SECRET_KEY
